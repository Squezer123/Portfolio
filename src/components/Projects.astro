---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/projects';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="projects" id="projects">
  <SectionHeading
    label={t('projects.label')}
    title={t('projects.title')}
    lead={t('projects.lead')}
  />

  <ul class="grid">
    {
      projects.map((project) => (
        <li class="item">
          <a class="card" href={project.href}>
            <div class="media">
              <img
                src={project.image}
                alt={project.alt[lang]}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="info">
              <h3>
                {project.title}
                <span aria-hidden="true">.</span>
              </h3>
              <p>{project.category[lang]}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .projects {
    padding: 0 var(--gutter) 140px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 32px;
    row-gap: 56px;
    margin-top: 130px;
  }

  /* druga kolumna przesunięta w dół, jak w projekcie */
  .item:nth-child(even) {
    margin-top: 96px;
  }

  .card {
    display: block;
  }

  .media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #1f1f1f;
  }

  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card:hover .media img {
    transform: scale(1.03);
  }

  .info {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(244, 242, 237, 0.12);
  }

  h3 {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .info p {
    font-size: 15px;
    color: var(--muted);
    text-align: right;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      margin-top: 64px;
    }

    .item:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
