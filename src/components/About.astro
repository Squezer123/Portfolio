---
import SectionHeading from './SectionHeading.astro';
import { getLang, useTranslations } from '../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));

const stats = [
  { value: t('about.stat1.value'), label: t('about.stat1.label') },
  { value: t('about.stat2.value'), label: t('about.stat2.label') },
  { value: t('about.stat3.value'), label: t('about.stat3.label') },
];
---

<section class="about" id="about">
  <SectionHeading label={t('about.label')} title={t('about.title')} />

  <div class="body indent">
    <div class="text">
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
    </div>

    <dl class="stats">
      {
        stats.map((stat) => (
          <div class="stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about {
    padding: 0 var(--gutter) 160px;
  }

  .body {
    margin-top: 72px;
    max-width: 780px;
  }

  .text {
    display: grid;
    gap: 24px;
    max-width: 600px;
  }

  .text p {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.7;
    color: var(--muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 72px 0 0;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 8px;
    padding-top: 20px;
    border-top: 1px solid rgba(244, 242, 237, 0.12);
  }

  dd {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  dt {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
