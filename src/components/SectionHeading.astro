---
interface Props {
  label: string;
  title: string;
  lead?: string;
}

const { label, title, lead } = Astro.props;
---

<div class="intro">
  <aside class="meta">
    <span class="line" aria-hidden="true"></span>
    <p class="label">{label}</p>
  </aside>
  <div class="heading">
    <h2>{title}</h2>
    {lead && <p class="lead">{lead}</p>}
  </div>
</div>

<style>
  .intro {
    display: grid;
    grid-template-columns: calc(var(--content-offset) - var(--gutter)) 1fr;
    align-items: start;
    padding-top: 28px;
  }

  .line {
    display: block;
    width: 14px;
    height: 2px;
    background: var(--accent);
    margin-bottom: 10px;
  }

  .label {
    font-size: 15px;
    font-weight: 500;
    padding-top: 6px;
  }

  h2 {
    font-size: clamp(2.6rem, 6.2vw, 5.1rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .lead {
    margin-top: 28px;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
