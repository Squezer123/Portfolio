---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLang, localizePath, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const links = [
  { label: t('nav.home'), href: '#home' },
  { label: t('nav.about'), href: '#about' },
  { label: t('nav.projects'), href: '#projects' },
  { label: t('nav.services'), href: '#services' },
  { label: t('nav.contact'), href: '#contact' },
];

const homeHref = localizePath('/', lang);
---

<header class="header">
  <a href={homeHref} class="logo">KK Projects<span>.</span></a>

  <nav class="nav" aria-label={t('nav.aria')}>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>
              {link.label}
              <span class="dot">.</span>
            </a>
          </li>
        ))
      }
    </ul>
    <LanguageSwitcher />
    <a href="#contact" class="cta">{t('nav.cta')}</a>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 17px var(--gutter);
    z-index: 100;
    background: rgba(23, 23, 23, 0.8);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(244, 242, 237, 0.08);
  }

  .logo {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .logo span {
    color: var(--accent);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav ul {
    display: flex;
    gap: 32px;
  }

  .nav ul a {
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .nav ul a:hover {
    color: var(--text);
  }

  .cta {
    padding: 9px 17px;
    border: 1px solid var(--border);
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .cta:hover {
    background: var(--text);
    color: var(--bg);
  }

  @media (max-width: 860px) {
    .nav {
      gap: 16px;
    }

    .nav ul {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .cta {
      display: none;
    }
  }
</style>
