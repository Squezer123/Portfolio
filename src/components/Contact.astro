---
import SectionHeading from './SectionHeading.astro';
import { getLang, useTranslations } from '../i18n/utils';

const t = useTranslations(getLang(Astro.currentLocale));
const email = t('contact.email');
---

<section class="contact" id="contact">
  <SectionHeading
    label={t('contact.label')}
    title={t('contact.title')}
    lead={t('contact.lead')}
  />

  <div class="body indent">
    <a class="mail" href={`mailto:${email}`}>{email}</a>

    <form class="form" novalidate data-status={t('contact.status')}>
      <div class="field">
        <label for="name">{t('contact.name')}</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="email">{t('contact.mail')}</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field full">
        <label for="message">{t('contact.message')}</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>
      <div class="actions full">
        <button type="submit" class="btn">{t('contact.send')}</button>
        <p class="status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<script>
  // Formularz nie ma jeszcze backendu — na razie tylko pokazuje komunikat.
  document.querySelectorAll<HTMLFormElement>('form[data-status]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('.status');
      if (status) status.textContent = form.dataset.status ?? '';
    });
  });
</script>

<style>
  .contact {
    padding: 0 var(--gutter) 120px;
  }

  .body {
    margin-top: 72px;
    max-width: 780px;
  }

  .mail {
    display: inline-block;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--text);
    padding-bottom: 2px;
  }

  .form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 32px;
    margin-top: 72px;
  }

  .full {
    grid-column: 1 / -1;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-size: 14px;
    color: var(--muted);
  }

  input,
  textarea {
    width: 100%;
    padding: 12px 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(244, 242, 237, 0.25);
    border-radius: 0;
    color: var(--text);
    font: inherit;
    font-size: 16px;
    resize: vertical;
    transition: border-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--accent);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .btn {
    padding: 15px 24px;
    background: var(--text);
    color: var(--bg);
    border: 0;
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .btn:hover {
    opacity: 0.85;
  }

  .status {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
